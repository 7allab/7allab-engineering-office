import test from 'node:test';
import assert from 'node:assert/strict';
import { spawnSync } from 'node:child_process';
import { mkdtempSync, mkdirSync, writeFileSync, linkSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';
import { checkReadPath, decide } from './hooks/guard.mjs';

const B = dirname(fileURLToPath(import.meta.url));
const ADAPTER = join(B, 'scripts', 'decision-gate-event-adapter.mjs');
const GUARD = join(B, 'hooks', 'guard.mjs');
const U = mkdtempSync(join(B, 'unit2-'));
const ROOT = join(U, 'proj');
const OUT = join(U, 'outside');
mkdirSync(ROOT, { recursive: true });
mkdirSync(OUT, { recursive: true });
writeFileSync(join(ROOT, 'a.txt'), 'inside');
writeFileSync(join(OUT, 's.txt'), 'outside');
let hardOk = true;
try { linkSync(join(OUT, 's.txt'), join(ROOT, 'hl.txt')); } catch { hardOk = false; }
const A = join(ROOT, 'a.txt');
const ev = (name, tool, ti) => ({ session_id: 's', cwd: ROOT, hook_event_name: name, tool_name: tool, tool_input: ti, ...(name === 'PreToolUse' ? { tool_use_id: 't1' } : {}) });
const raw = (o) => Buffer.from(typeof o === 'string' ? o : JSON.stringify(o));

test('review: adapter path must be absolute (a relative one would resolve against a model-writable cwd)', () => {
  for (const p of ['scripts\\decision-gate-event-adapter.mjs', '.\\a.mjs', '..\\a.mjs', '/x/a.mjs', '\\\\srv\\share\\a.mjs', undefined, '']) {
    const r = decide(raw(ev('PreToolUse', 'Read', { file_path: A })), { adapterPath: p, projectDir: ROOT });
    assert.equal(r.exitCode, 2, String(p));
  }
  assert.equal(decide(raw(ev('PreToolUse', 'Read', { file_path: A })), { adapterPath: ADAPTER, projectDir: ROOT }).exitCode, 0);
});

test('review: a hook pinned to PermissionRequest answers with the deny JSON even when the input is unparsable, oversized or the wrong event', () => {
  const pin = { adapterPath: ADAPTER, projectDir: ROOT, expectEvent: 'PermissionRequest' };
  for (const input of [null, Buffer.alloc(0), raw('garbage'), raw('{'), raw([]), raw({ hook_event_name: 'PreToolUse', session_id: 's', cwd: ROOT, tool_name: 'Read', tool_input: {}, tool_use_id: 't' }), raw({})]) {
    const r = decide(input, pin);
    assert.equal(r.exitCode, 0);
    assert.equal(JSON.parse(r.stdout).hookSpecificOutput.decision.behavior, 'deny');
  }
  const pre = decide(raw('garbage'), { adapterPath: ADAPTER, projectDir: ROOT, expectEvent: 'PreToolUse' });
  assert.deepEqual([pre.exitCode, pre.stdout], [2, '']);
  assert.equal(decide(raw(ev('PermissionRequest', 'Write', { file_path: A, content: 'x' })), { adapterPath: ADAPTER, projectDir: ROOT, expectEvent: 'PreToolUse' }).exitCode, 2, 'mismatch with the pinned PreToolUse protocol');
});

test('review: hard links, secrets-looking names and VCS / settings directories are not verified-safe reads', { skip: !hardOk && 'hard link creation not permitted: NOT TESTED' }, () => {
  assert.equal(checkReadPath(join(ROOT, 'hl.txt'), ROOT).code, 'HARD_LINKED_FILE');
});

test('review: sensitive names are refused before any filesystem lookup', () => {
  for (const n of ['.env', '.env.local', '.git\\config', '.claude\\settings.json', '.ssh\\id_rsa', 'id_rsa', 'id_ed25519.pub', 'a.pem', 'k.key', 'c.pfx', '.npmrc', '.netrc', '.aws\\credentials', 'X.PEM']) {
    assert.equal(checkReadPath(ROOT + '\\' + n, ROOT).code, 'SENSITIVE_NAME', n);
  }
  assert.equal(checkReadPath(A, ROOT).ok, true);
});

test('review: the adapter child gets a minimal environment (no NODE_OPTIONS and friends)', () => {
  let seen;
  const spawn = (cmd, args, o) => { seen = o; return { status: 0, stdout: '', stderr: '' }; };
  process.env.NODE_OPTIONS = '--require x';
  process.env.CLAUDE_FAKE_SECRET = 'S';
  const r = decide(raw(ev('PreToolUse', 'Read', { file_path: A })), { adapterPath: ADAPTER, projectDir: ROOT, spawn });
  delete process.env.NODE_OPTIONS;
  delete process.env.CLAUDE_FAKE_SECRET;
  assert.equal(r.exitCode, 0);
  assert.ok(!('NODE_OPTIONS' in seen.env) && !('CLAUDE_FAKE_SECRET' in seen.env));
  assert.equal(seen.env.CLAUDE_PROJECT_DIR, ROOT);
  assert.ok('SystemRoot' in seen.env, 'Windows needs SystemRoot to start node');
});

test('review: CLI emits the whole PermissionRequest deny JSON on stdout and leaves the exit code to the process (no truncation, exit 0)', () => {
  const g = (input, args) => spawnSync(process.execPath, [GUARD, ADAPTER, ...args], { input, encoding: 'utf8', env: { ...process.env, CLAUDE_PROJECT_DIR: ROOT } });
  for (const input of [JSON.stringify(ev('PermissionRequest', 'Write', { file_path: A, content: 'x'.repeat(5000) })), 'garbage', Buffer.alloc(1100000, 0x41)]) {
    const r = g(input, ['--event', 'PermissionRequest']);
    assert.equal(r.status, 0);
    const j = JSON.parse(r.stdout);
    assert.equal(j.hookSpecificOutput.decision.behavior, 'deny');
    assert.ok(r.stdout.startsWith('{') && r.stdout.endsWith('}'));
  }
  const pre = g('garbage', ['--event', 'PreToolUse']);
  assert.deepEqual([pre.status, pre.stdout], [2, '']);
  assert.match(pre.stderr, /^BLOCKED\(wrapper\)/);
});
