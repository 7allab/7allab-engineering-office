{
  "_about": "Deterministic hook inputs for DIRECT-FEED tests (stdin of scripts/guard.mjs, no model). 'expect' values are DERIVED FROM READING scripts/guard.mjs, NOT TESTED. {{PROJECT}} = sandbox project dir (C:\\work). Direct feed is not live Claude Code enforcement.",
  "events": [
    { "id": "E01_write_unauth", "raw": null, "event": { "hook_event_name": "PreToolUse", "session_id": "s1", "cwd": "{{PROJECT}}", "tool_use_id": "t1", "tool_name": "Write", "tool_input": { "file_path": "{{PROJECT}}\\a.txt", "content": "x" } }, "expect": { "exit": 2, "stdout_empty": true } },
    { "id": "E02_edit_unauth", "raw": null, "event": { "hook_event_name": "PreToolUse", "session_id": "s1", "cwd": "{{PROJECT}}", "tool_use_id": "t2", "tool_name": "Edit", "tool_input": { "file_path": "{{PROJECT}}\\a.txt", "old_string": "x", "new_string": "y" } }, "expect": { "exit": 2, "stdout_empty": true } },
    { "id": "E03_bash_unauth", "raw": null, "event": { "hook_event_name": "PreToolUse", "session_id": "s1", "cwd": "{{PROJECT}}", "tool_use_id": "t3", "tool_name": "Bash", "tool_input": { "command": "echo pilot" } }, "expect": { "exit": 2, "stdout_empty": true } },
    { "id": "E04_powershell_unauth", "raw": null, "event": { "hook_event_name": "PreToolUse", "session_id": "s1", "cwd": "{{PROJECT}}", "tool_use_id": "t4", "tool_name": "PowerShell", "tool_input": { "command": "Get-Date" } }, "expect": { "exit": 2, "stdout_empty": true } },
    { "id": "E05_read_inside", "raw": null, "setup": "requires {{PROJECT}}\\readme.txt, a plain file, created by the owner-approved runner", "event": { "hook_event_name": "PreToolUse", "session_id": "s1", "cwd": "{{PROJECT}}", "tool_use_id": "t5", "tool_name": "Read", "tool_input": { "file_path": "{{PROJECT}}\\readme.txt" } }, "expect": { "exit": 0, "stdout_empty": true } },
    { "id": "E06_read_outside", "raw": null, "event": { "hook_event_name": "PreToolUse", "session_id": "s1", "cwd": "{{PROJECT}}", "tool_use_id": "t6", "tool_name": "Read", "tool_input": { "file_path": "C:\\Windows\\win.ini" } }, "expect": { "exit": 2, "stdout_empty": true } },
    { "id": "E07_glob_unverified", "raw": null, "event": { "hook_event_name": "PreToolUse", "session_id": "s1", "cwd": "{{PROJECT}}", "tool_use_id": "t7", "tool_name": "Glob", "tool_input": { "pattern": "*" } }, "expect": { "exit": 2, "stdout_empty": true } },
    { "id": "E08_not_json", "raw": "this is not json", "event": null, "expect": { "exit": 2, "stdout_empty": true } },
    { "id": "E09_schema_missing_fields", "raw": null, "event": { "hook_event_name": "PreToolUse", "tool_name": "Read" }, "expect": { "exit": 2, "stdout_empty": true } },
    { "id": "E10_permission_request_write", "raw": null, "event": { "hook_event_name": "PermissionRequest", "session_id": "s1", "cwd": "{{PROJECT}}", "tool_name": "Write", "tool_input": { "file_path": "{{PROJECT}}\\a.txt", "content": "x" } }, "expect": { "exit": 0, "stdout_is": "permission_request_deny_json" }, "run_with": "--event PermissionRequest" }
  ]
}
