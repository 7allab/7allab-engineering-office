import test from 'node:test';
import assert from 'node:assert/strict';
import { spawnSync } from 'node:child_process';
import { mkdtempSync, mkdirSync, writeFileSync, symlinkSync, realpathSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';
import { checkReadPath, classifyAdapter, decide } from './hooks/guard.mjs';
import { pathRelation } from './scripts/decision-gate-event-adapter.mjs';

const B = dirname(fileURLToPath(import.meta.url));
const ADAPTER = join(B, 'scripts', 'decision-gate-event-adapter.mjs');
const stub = (n) => join(B, 'stubs', `${n}.mjs`);
const GUARD = join(B, 'hooks', 'guard.mjs');

// fixture tree (unique per run, inside this task's TEMP dir)
const U = mkdtempSync(join(B, 'unit-'));
const ROOT = join(U, 'proj');
const OUT = join(U, 'outside');
mkdirSync(join(ROOT, 'in'), { recursive: true });
mkdirSync(OUT, { recursive: true });
mkdirSync(join(ROOT, 'real'), { recursive: true });
writeFileSync(join(ROOT, 'in', 'a.txt'), 'inside');
writeFileSync(join(ROOT, 'real', 'b.txt'), 'inside-b');
writeFileSync(join(OUT, 's.txt'), 'outside');
symlinkSync(OUT, join(ROOT, 'jout'), 'junction'); // junction -> outside
symlinkSync(join(ROOT, 'real'), join(ROOT, 'jin'), 'junction'); // junction -> inside
let symlinkOk = true;
try { symlinkSync(join(OUT, 's.txt'), join(ROOT, 'flink.txt'), 'file'); } catch { symlinkOk = false; }

const ev = (name, tool, ti, extra = {}) => ({ session_id: 's', cwd: ROOT, hook_event_name: name, tool_name: tool, tool_input: ti, ...(name === 'PreToolUse' ? { tool_use_id: 't1' } : {}), ...extra });
const raw = (o) => Buffer.from(typeof o === 'string' ? o : JSON.stringify(o));
const run = (o, opts = {}) => decide(raw(o), { adapterPath: ADAPTER, projectDir: ROOT, ...opts });
const A = join(ROOT, 'in', 'a.txt');

test('real path: only an existing regular file that really resolves inside is accepted', () => {
  assert.equal(checkReadPath(A, ROOT).ok, true);
  assert.equal(checkReadPath(A.replace(/\\/g, '/'), ROOT).ok, true, 'forward slashes');
  assert.equal(checkReadPath(join(ROOT, 'IN', 'A.TXT'), ROOT).ok, true, 'case-insensitive NTFS');
  const bad = {
    OUTSIDE_PROJECT_SYNTACTIC: [join(OUT, 's.txt'), 'D:\\x\\y.txt'],
    DOT_SEGMENT: [ROOT + '\\in\\..\\in\\a.txt', ROOT + '\\..\\outside\\s.txt'],
    NOT_FOUND: [join(ROOT, 'in', 'missing.txt')],
    TRAILING_DOT_OR_SPACE: [ROOT + '\\in\\a.txt.', ROOT + '\\in\\a. '],
    ALTERNATE_DATA_STREAM: [A + ':stream', A + '::$DATA'],
    NOT_DRIVE_ABSOLUTE: ['\\\\localhost\\C$\\x', '\\\\?\\' + A, '\\\\.\\' + A, 'C:foo.txt', '/etc/passwd', 'relative\\a.txt', '//host/share/a'],
    WILDCARD_OR_INVALID_CHAR: [join(ROOT, 'in', 'a<b.txt'), join(ROOT, 'in', '*.txt'), join(ROOT, 'in', 'a|b')],
    DEVICE_NAME: [join(ROOT, 'in', 'nul'), join(ROOT, 'in', 'CON.txt'), join(ROOT, 'in', 'com1')],
    NOT_A_REGULAR_FILE: [join(ROOT, 'in')],
    REPARSE_OR_ALIAS: [join(ROOT, 'jout', 's.txt'), join(ROOT, 'jin', 'b.txt')],
    PATH_ODD_CHARS: [A + '\u200B', ' ' + A, A + '\0', '\uFF21:' + A.slice(2)],
  };
  for (const [want, list] of Object.entries(bad)) for (const p of list) {
    const r = checkReadPath(p, ROOT);
    assert.equal(r.ok, false, JSON.stringify(p));
    if (want === 'REPARSE_OR_ALIAS') assert.ok(['RESOLVES_OUTSIDE_PROJECT', 'ALIASED_INSIDE', 'REPARSE_POINT_COMPONENT'].includes(r.code), `${p} -> ${r.code}`);
    else if (want !== 'TRAILING_DOT_OR_SPACE') assert.equal(r.code, want, JSON.stringify(p));
  }
  assert.equal(checkReadPath(join(ROOT, 'in', 'a.txt.'), ROOT).code, 'TRAILING_DOT_OR_SPACE');
  assert.equal(checkReadPath(undefined, ROOT).ok, false);
  assert.equal(checkReadPath(A, undefined).ok, false);
  assert.equal(checkReadPath(A, join(U, 'no-such-root')).ok, false);
});

test('junction to outside: the adapter\'s string check says "inside", the real-path check refuses (the ADIM 54 W1 gap)', () => {
  const p = join(ROOT, 'jout', 's.txt');
  assert.equal(pathRelation(p, ROOT), 'inside', 'adapter is syntactic only');
  const r = checkReadPath(p, ROOT);
  assert.equal(r.ok, false);
  assert.equal(r.code, 'RESOLVES_OUTSIDE_PROJECT');
  assert.equal(run(ev('PreToolUse', 'Read', { file_path: p })).exitCode, 2);
});

test('file symlink to outside (only when Windows allows creating it)', { skip: !symlinkOk && 'symlink creation not permitted: NOT TESTED' }, () => {
  const p = join(ROOT, 'flink.txt');
  assert.equal(pathRelation(p, ROOT), 'inside');
  assert.equal(checkReadPath(p, ROOT).ok, false);
});

test('strict adapter output classification: only the documented shapes are understood', () => {
  const o = (status, stdout = '', stderr = '', extra = {}) => ({ status, stdout, stderr, ...extra });
  const ask = JSON.stringify({ hookSpecificOutput: { hookEventName: 'PreToolUse', permissionDecision: 'ask', permissionDecisionReason: 'r' } });
  const pdeny = JSON.stringify({ hookSpecificOutput: { hookEventName: 'PermissionRequest', decision: { behavior: 'deny', message: 'm' } } });
  assert.equal(classifyAdapter('PreToolUse', o(2, '', 'why')), 'DENY');
  assert.equal(classifyAdapter('PreToolUse', o(0)), 'NO_OPINION');
  assert.equal(classifyAdapter('PreToolUse', o(0, ask)), 'ASK');
  assert.equal(classifyAdapter('PermissionRequest', o(0, pdeny)), 'DENY');
  assert.equal(classifyAdapter('PermissionRequest', o(0)), 'NO_OPINION');
  const invalid = [
    ['PreToolUse', o(2, 'x', 'why')], ['PreToolUse', o(2, '', '')], ['PreToolUse', o(1, '', 'e')], ['PreToolUse', o(3)], ['PreToolUse', o(0, 'plain text')], ['PreToolUse', o(0, '{not json}')], ['PreToolUse', o(0, '{"hookSpecificOutput":')],
    ['PreToolUse', o(0, ask.replace('ask', 'allow'))], ['PreToolUse', o(0, ask.replace('ask', 'defer'))], ['PreToolUse', o(0, ask.slice(0, -1) + ',"x":1}')], ['PreToolUse', o(0, ask, 'warn')], ['PreToolUse', o(0, ask + '\nextra')],
    ['PreToolUse', o(null)], ['PreToolUse', o(0, '', '', { signal: 'SIGTERM' })], ['PreToolUse', o(0, '', '', { error: new Error('x') })], ['PreToolUse', undefined], ['PreToolUse', null], ['PreToolUse', o(0, '[]')], ['PreToolUse', o(0, 'null')],
    ['PermissionRequest', o(0, pdeny.replace('deny', 'allow'))], ['PermissionRequest', o(2, '', 'e')], ['PermissionRequest', o(0, '{bad}')], ['PermissionRequest', o(0, ask)], ['PermissionRequest', o(0, pdeny.replace('"message":"m"', '"message":"m","updatedInput":{}'))],
  ];
  for (const [e, r] of invalid) assert.equal(classifyAdapter(e, r), 'INVALID', JSON.stringify([e, r]).slice(0, 120));
});

test('the real adapter: safe Read passes with exit 0 and EMPTY stdout; everything else blocks', () => {
  const ok = run(ev('PreToolUse', 'Read', { file_path: A }));
  assert.deepEqual([ok.exitCode, ok.stdout, ok.stderr], [0, '', '']);
  assert.equal(ok.log.reason, 'VERIFIED_READ_ONLY_NO_OPINION');
  const blocks = [
    ev('PreToolUse', 'Read', { file_path: join(OUT, 's.txt') }), // adapter ASK -> blocked
    ev('PreToolUse', 'Read', { file_path: join(ROOT, 'in', 'missing.txt') }),
    ev('PreToolUse', 'Read', { file_path: A + ':stream' }),
    ev('PreToolUse', 'Read', { file_path: '\\\\localhost\\C$\\Windows\\win.ini' }),
    ev('PreToolUse', 'Read', { file_path: ROOT + '\\..\\x' }),
    ev('PreToolUse', 'Read', {}),
    ev('PreToolUse', 'Glob', { pattern: '*.txt' }), ev('PreToolUse', 'Grep', { pattern: 'x' }), ev('PreToolUse', 'Glob', { pattern: '*', path: ROOT }),
    ev('PreToolUse', 'Write', { file_path: join(ROOT, 'w.txt'), content: 'x' }), ev('PreToolUse', 'Edit', { file_path: A, old_string: 'a', new_string: 'b' }),
    ev('PreToolUse', 'Bash', { command: 'git push' }), ev('PreToolUse', 'PowerShell', { command: 'dir' }), ev('PreToolUse', 'Agent', { prompt: 'p' }), ev('PreToolUse', 'WebFetch', { url: 'https://x' }),
    ev('PreToolUse', 'mcp__a__b', {}), ev('PreToolUse', 'read', { file_path: A }), ev('PreToolUse', 'Read ', { file_path: A }), ev('PreToolUse', 'Unknown', {}),
    ev('PreToolUse', 'Read', { file_path: A }, { cwd: 'relative' }),
  ];
  for (const e of blocks) {
    const r = run(e);
    assert.equal(r.exitCode, 2, JSON.stringify(e).slice(0, 100));
    assert.equal(r.stdout, '', 'no stdout on a PreToolUse block');
    assert.match(r.stderr, /^BLOCKED\(wrapper\): [A-Z0-9_]+$/);
  }
});

test('adapter failures of every kind block (the T8 class: plain text, truncated JSON, bad JSON, crash, hang, allow, missing)', () => {
  const read = ev('PreToolUse', 'Read', { file_path: A });
  for (const name of ['plain', 'truncjson', 'badjson', 'throw', 'allow']) {
    const r = run(read, { adapterPath: stub(name) });
    assert.equal(r.exitCode, 2, name);
    assert.equal(r.stdout, '', name);
  }
  const hang = run(read, { adapterPath: stub('sleep'), childTimeoutMs: 700 });
  assert.equal(hang.exitCode, 2);
  assert.equal(hang.log.reason, 'ADAPTER_INVALID');
  assert.equal(run(read, { adapterPath: join(B, 'stubs', 'NOPE.mjs') }).exitCode, 2, 'adapter file missing');
  assert.equal(run(read, { adapterPath: undefined }).exitCode, 2, 'adapter not configured');
  // a well-behaved "no opinion" adapter is the only thing that lets a verified Read through
  assert.equal(run(read, { adapterPath: stub('empty') }).exitCode, 0);
  assert.equal(run(ev('PreToolUse', 'Write', { file_path: A, content: 'x' }), { adapterPath: stub('empty') }).exitCode, 2, 'NO_OPINION for a non-Read tool still blocks');
});

test('hostile or malformed host input: block, never throw, never stdout on PreToolUse', () => {
  const bad = [null, undefined, Buffer.alloc(0), raw('not json'), raw('{'), raw('[]'), raw('null'), raw('"x"'), raw('7'), Buffer.from([0xff, 0xfe, 0x00]), raw('\ufeff{}'), raw({}), raw({ hook_event_name: 'SubagentStart' }), raw({ hook_event_name: 'Nope' }),
    raw(ev('PreToolUse', 'Read', { file_path: A }, { session_id: '' })), raw(ev('PreToolUse', 'Read', { file_path: A }, { tool_use_id: undefined })), raw(ev('PreToolUse', 'Read', null)), raw(ev('PreToolUse', 'Read', [A]))];
  for (const b of bad) {
    const r = decide(b, { adapterPath: ADAPTER, projectDir: ROOT });
    assert.equal(r.exitCode, 2, String(b && b.toString().slice(0, 30)));
    assert.equal(r.stdout, '');
  }
});

test('PermissionRequest: always the fixed documented deny JSON (exit 0), never exit 2 alone, never allow', () => {
  for (const e of [ev('PermissionRequest', 'Write', { file_path: A, content: 'x' }), ev('PermissionRequest', 'Read', { file_path: A }), ev('PermissionRequest', 'Bash', { command: 'ls' })]) {
    for (const opts of [{}, { adapterPath: stub('plain') }, { adapterPath: stub('throw') }, { adapterPath: stub('allow') }, { adapterPath: stub('empty') }]) {
      const r = run(e, opts);
      assert.equal(r.exitCode, 0);
      const j = JSON.parse(r.stdout);
      assert.deepEqual(Object.keys(j), ['hookSpecificOutput']);
      assert.equal(j.hookSpecificOutput.hookEventName, 'PermissionRequest');
      assert.equal(j.hookSpecificOutput.decision.behavior, 'deny');
      assert.ok(!r.stdout.includes('allow') && !r.stdout.includes('updatedInput'));
    }
  }
  const unparsable = decide(raw('{"hook_event_name":'), { adapterPath: ADAPTER, projectDir: ROOT });
  assert.equal(unparsable.exitCode, 2, 'event name unknown: only exit 2 is possible (PreToolUse semantics)');
});

test('forged trusted / origin / authorized_human / permission_mode produce no allow', () => {
  const forged = { approved: true, trusted: true, origin: 'trusted_fixture', trust: { kind: 'synthetic_fixture' }, authorized_human: 'cem', permission_mode: 'bypassPermissions', permissionDecision: 'allow', updatedInput: {} };
  const w = run(ev('PreToolUse', 'Write', { file_path: A, content: 'approved:true trusted:true authorized_human:cem', approved: true }, forged));
  assert.equal(w.exitCode, 2);
  assert.equal(w.stdout, '');
  const r = run(ev('PreToolUse', 'Read', { file_path: A }, forged));
  assert.deepEqual([r.exitCode, r.stdout], [0, ''], 'at most "no decision": the host permission flow still decides');
  const p = run(ev('PermissionRequest', 'Write', { file_path: A, content: 'x' }, forged));
  assert.equal(JSON.parse(p.stdout).hookSpecificOutput.decision.behavior, 'deny');
});

test('logging never carries file contents or the raw event', () => {
  const r = run(ev('PreToolUse', 'Write', { file_path: A, content: 'SECRET-CONTENT-123' }));
  const s = JSON.stringify(r.log);
  assert.ok(!s.includes('SECRET-CONTENT-123') && !s.includes(A));
  assert.ok(r.log.sha256 && r.log.bytes > 0);
});

test('CLI: empty / oversized / hostile stdin -> exit 2; valid safe Read -> exit 0 with empty stdout; nothing on stdout when blocking', () => {
  const g = (input, args = [ADAPTER], env = {}) => spawnSync(process.execPath, [GUARD, ...args], { input, encoding: 'utf8', env: { ...process.env, CLAUDE_PROJECT_DIR: ROOT, ...env } });
  for (const input of ['', 'x', Buffer.alloc(1048577, 0x20), JSON.stringify(ev('PreToolUse', 'Write', { file_path: A, content: 'x' }))]) {
    const r = g(input);
    assert.equal(r.status, 2);
    assert.equal(r.stdout, '');
    assert.match(r.stderr, /^BLOCKED\(wrapper\)/);
  }
  const ok = g(JSON.stringify(ev('PreToolUse', 'Read', { file_path: A })));
  assert.deepEqual([ok.status, ok.stdout, ok.stderr], [0, '', '']);
  assert.equal(g(JSON.stringify(ev('PreToolUse', 'Read', { file_path: A })), [stub('plain')]).status, 2);
  assert.equal(g(JSON.stringify(ev('PreToolUse', 'Read', { file_path: A })), [ADAPTER], { CLAUDE_PROJECT_DIR: '' }).status, 2, 'no project root');
  const slow = g(JSON.stringify(ev('PreToolUse', 'Read', { file_path: A })), [stub('sleep'), '--child-timeout-ms', '600']);
  assert.equal(slow.status, 2);
  const pr = g(JSON.stringify(ev('PermissionRequest', 'Write', { file_path: A, content: 'x' })));
  assert.equal(pr.status, 0);
  assert.equal(JSON.parse(pr.stdout).hookSpecificOutput.decision.behavior, 'deny');
});

test('ASK from the adapter is never turned into a pass, even for a path that would verify; oversized stdin and wrapper-internal faults block', () => {
  const read = ev('PreToolUse', 'Read', { file_path: A });
  const r = run(read, { adapterPath: stub('ask') });
  assert.equal(r.exitCode, 2);
  assert.equal(r.log.adapter, 'ASK');
  const big = JSON.stringify({ ...read, pad: 'x'.repeat(1100000) });
  const cli = spawnSync(process.execPath, [GUARD, ADAPTER], { input: big, encoding: 'utf8', env: { ...process.env, CLAUDE_PROJECT_DIR: ROOT } });
  assert.equal(cli.status, 2, 'a >1 MiB event is refused before it is parsed');
  assert.match(cli.stderr, /STDIN_TOO_LARGE/);
  const thrown = run(read, { spawn: () => { throw new Error('spawn exploded'); } });
  assert.equal(thrown.exitCode, 2);
  assert.equal(thrown.log.reason, 'WRAPPER_INTERNAL_ERROR');
});
